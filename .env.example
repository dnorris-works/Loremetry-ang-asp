# Docker Compose reads POSTGRES_* when starting the database.
# The backend loads this file on startup for auth and provider settings.
# On deployment, set the same variable names in your host's app environment.

POSTGRES_USER=loremetry
POSTGRES_PASSWORD=loremetry
POSTGRES_DB=loremetry
POSTGRES_PORT=5432

# Clerk (https://dashboard.clerk.com → API keys)
# Publishable key and Frontend API URL (issuer). Do not include /.well-known/... paths.
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Operator break-glass sign-in (paste this value on the login page).
OPERATOR_KEY=generate_a_long_random_secret

# Optional: email for the bootstrap operator user record (default: admin@local)
# BOOTSTRAP_ADMIN_EMAIL=admin@local

# Provider API keys and defaults (seeded into lore.platform_settings on first run)
anthropic_api_key=
tokenmix_api_key=
canopy_api_key=
dataforseo_login=
dataforseo_password=
default_provider=tokenmix
